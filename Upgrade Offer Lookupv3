<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Device Upgrade Offer Lookup | Boost Mobile</title>
<style>
@font-face{font-family:"Druk";src:url("fonts/Druk-SuperItalic-Web.woff2") format("woff2");font-weight:900;font-style:italic;font-display:swap}
@font-face{font-family:"Druk Text Wide";src:url("fonts/DrukTextWide-Heavy-Web.woff2") format("woff2");font-weight:800;font-style:normal;font-display:swap}
@font-face{font-family:"Neue Haas Grotesk Text";src:url("fonts/NeueHaasGroteskText-Roman.ttf") format("truetype");font-weight:400;font-display:swap}
@font-face{font-family:"Neue Haas Grotesk Text";src:url("fonts/NeueHaasGroteskText-Bold.ttf") format("truetype");font-weight:700;font-display:swap}
:root{
  --orange:#FC5400;--yellow:#FFFE00;--blue:#0072EC;--ink:#1A1A1A;--muted:#5E5E5E;--line:#E4E4E4;--soft:#F5F5F5;--blue-soft:#EEF5FE;
  --h1:"Druk","Arial Narrow",Impact,sans-serif;
  --h2:"Druk Text Wide","Arial Black",sans-serif;
  --body:"Neue Haas Grotesk Text","Helvetica Neue",Helvetica,Arial,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;font-family:var(--body);color:var(--ink);background:#fff;-webkit-font-smoothing:antialiased}
.wrap{max-width:960px;margin:0 auto;padding:0 0 24px}
header{background:var(--orange);color:#fff;padding:22px 28px 18px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:6px solid var(--yellow)}
header h1{font-family:var(--h1);font-style:italic;font-weight:900;text-transform:uppercase;font-size:clamp(34px,6vw,60px);line-height:.88;margin:0;letter-spacing:0}
header p{margin:8px 0 0;font-weight:700;font-size:15px}
header img{height:56px;width:auto;flex-shrink:0}
main{padding:24px 28px 0}
.step{margin-bottom:22px}
.label{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.num{width:28px;height:28px;border-radius:50%;background:var(--blue);color:#fff;font-weight:700;font-size:14px;display:grid;place-items:center;flex-shrink:0}
.label h2{font-family:var(--h2);font-weight:800;font-size:17px;letter-spacing:-.05em;margin:0}
.hint{font-size:14px;color:var(--muted);margin:-4px 0 12px 38px;line-height:1.45}
.colors{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.cbtn{border:3px solid transparent;border-radius:12px;padding:16px 6px;cursor:pointer;font-family:var(--h1);font-style:italic;font-weight:900;text-transform:uppercase;font-size:28px;color:var(--ink);transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;line-height:1}
.cbtn:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.12)}
.cbtn[aria-pressed="true"]{border-color:var(--ink);box-shadow:0 0 0 3px #fff inset,0 4px 14px rgba(0,0,0,.18)}
.cbtn:focus-visible,.pbtn:focus-visible,.reset:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.plans{display:flex;gap:10px;flex-wrap:wrap}
.pbtn{flex:1;min-width:110px;border:2px solid var(--blue);background:#fff;color:var(--blue);border-radius:999px;padding:12px 18px;font-family:var(--body);font-weight:700;font-size:20px;cursor:pointer;transition:all .15s ease}
.pbtn small{display:block;font-size:12px;font-weight:400;opacity:.8}
.pbtn:hover{background:var(--blue-soft)}
.pbtn[aria-pressed="true"]{background:var(--blue);color:#fff}
.pbtn:disabled{border-color:var(--line);color:#B5B5B5;cursor:not-allowed;background:#fff}
.locked{opacity:.45;pointer-events:none}
.results{border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.rhead{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;color:var(--ink)}
.rhead .tier{font-family:var(--h1);font-style:italic;font-weight:900;text-transform:uppercase;font-size:34px;line-height:1}
.rhead .plan{font-weight:700;font-size:16px;background:rgba(255,255,255,.85);padding:6px 12px;border-radius:999px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:0;background:#fff}
.card{padding:20px 18px;border-right:1px solid var(--line);text-align:center}
.card:last-child{border-right:0}
.brand{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.device{font-family:var(--h2);font-weight:800;font-size:16px;letter-spacing:-.05em;margin:6px 0 2px}
.retail{font-size:13px;color:var(--muted)}
.retail s{color:var(--muted)}
.price{font-family:var(--body);font-weight:700;font-size:38px;color:var(--orange);margin:12px 0 2px;line-height:1}
.save{display:inline-block;font-size:13px;font-weight:700;background:var(--yellow);padding:3px 9px;border-radius:999px}
.save.none{background:var(--soft);color:var(--muted)}
.empty{padding:34px 20px;text-align:center;color:var(--muted);background:var(--soft);border-radius:14px;font-size:15px;line-height:1.5}
.empty b{color:var(--ink)}
.note{background:var(--ink);color:#fff;border-radius:10px;padding:12px 16px;margin-top:18px;display:flex;gap:10px;align-items:center;font-size:14px;line-height:1.4}
.note b{font-family:var(--h2);font-weight:800;color:var(--yellow);letter-spacing:-.04em;white-space:nowrap}
.fine{font-size:12px;color:var(--muted);margin-top:12px}
.reset{background:none;border:0;color:var(--blue);font-family:var(--body);font-weight:700;font-size:14px;cursor:pointer;padding:4px 0;margin-left:auto}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
@media (max-width:640px){
  header{padding:18px}header img{height:40px}main{padding:18px 18px 0}
  .colors{grid-template-columns:repeat(3,1fr)}.cbtn{font-size:24px}
  .cards{grid-template-columns:1fr}.card{border-right:0;border-bottom:1px solid var(--line)}.card:last-child{border-bottom:0}
  .hint{margin-left:0}
}
@media (prefers-reduced-motion:no-preference){
  .fade{animation:fade .25s ease-out both}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <h1>Device Upgrade<br>Offer Lookup</h1>
      <p>Offers valid 10.28.26 – 11.09.26 &nbsp;|&nbsp; Targeted offers available through e-Pay</p>
    </div>
    <img src="data:image/png;base64," alt="Boost Mobile">
  </header>

  <main>
    <section class="step">
      <div class="label"><span class="num">1</span><h2>Select The Customer's Offer Color</h2><button class="reset" id="reset" hidden="">Start over</button></div>
      <p class="hint">Find the offer color in the e-Pay pop-up. Colors are for internal use only, so never share them with customers.</p>
      <div class="colors" id="colors" role="group" aria-label="Offer color"></div>
    </section>

    <section class="step" id="planStep">
      <div class="label"><span class="num">2</span><h2>Select The Rate Plan</h2></div>
      <div class="plans" id="plans" role="group" aria-label="Rate plan"></div>
    </section>

    <section class="step">
      <div class="label"><span class="num">3</span><h2>Device Offers</h2></div>
      <div id="results" aria-live="polite"></div>
    </section>

    <div class="note"><b>Internal Use Only</b><span>Never share offer colors with customers.</span></div>
    <p class="fine">*Offers are subject to change at any time.</p>
  </main>
</div>

<script>
/* ===== Offer data — update here each offer period ===== */
const DEVICES = [
  { brand: "Google",   name: "Pixel 10a",      retail: 499.99 },
  { brand: "Motorola", name: "moto razr 2025", retail: 599.99 },
  { brand: "Samsung",  name: "Galaxy S26 FE",  retail: 699.99 }
];
const PLANS = [60, 50, 40];
// Prices in DEVICES order for each plan
const OFFERS = {
  Orange: { 60: [0.00, 69.99, 249.99],   50: [99.99, 159.99, 349.99],  40: [259.99, 459.99, 579.99] },
  Green:  { 60: [49.99, 149.99, 299.99], 50: [149.99, 199.99, 449.99], 40: [344.99, 549.99, 669.99] },
  Purple: { 60: [99.99, 169.99, 399.99], 50: [269.99, 479.99, 589.99], 40: [379.99, 599.99, 699.99] },
  Yellow: { 60: [199.99, 429.99, 499.99],50: [359.99, 559.99, 679.99], 40: [379.99, 599.99, 699.99] },
  Cyan:   { 60: [299.99, 499.99, 619.99],50: [379.99, 599.99, 699.99], 40: [379.99, 599.99, 699.99] }
};
const TIER_COLORS = { Orange:"#FF8A1F", Green:"#3BB54A", Purple:"#8E5BD6", Yellow:"#FFC91F", Cyan:"#1CCAD8" };
/* ====================================================== */

const state = { color: null, plan: null };
const $ = id => document.getElementById(id);
const money = v => "$" + v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

function buildColors() {
  $("colors").innerHTML = Object.keys(OFFERS).map(c =>
    `<button class="cbtn" style="background:${TIER_COLORS[c]}" data-color="${c}" aria-pressed="false">${c}</button>`).join("");
  $("colors").querySelectorAll(".cbtn").forEach(b => b.onclick = () => { state.color = b.dataset.color; render(); });
}
function buildPlans() {
  $("plans").innerHTML = PLANS.map(p =>
    `<button class="pbtn" data-plan="${p}" aria-pressed="false" disabled>$${p}<small>rate plan</small></button>`).join("");
  $("plans").querySelectorAll(".pbtn").forEach(b => b.onclick = () => { state.plan = +b.dataset.plan; render(); });
}
function render() {
  document.querySelectorAll(".cbtn").forEach(b => b.setAttribute("aria-pressed", b.dataset.color === state.color));
  document.querySelectorAll(".pbtn").forEach(b => {
    b.disabled = !state.color;
    b.setAttribute("aria-pressed", +b.dataset.plan === state.plan);
  });
  $("planStep").classList.toggle("locked", !state.color);
  $("reset").hidden = !state.color;

  const r = $("results");
  if (!state.color) { r.innerHTML = `<div class="empty">Select an <b>offer color</b> to get started.</div>`; return; }
  if (!state.plan)  { r.innerHTML = `<div class="empty">Now select the customer's <b>rate plan</b> to see their device offers.</div>`; return; }

  const prices = OFFERS[state.color][state.plan];
  r.innerHTML = `<div class="results fade">
    <div class="rhead" style="background:${TIER_COLORS[state.color]}">
      <span class="tier">${state.color}</span><span class="plan">$${state.plan} Rate Plan</span>
    </div>
    <div class="cards">${DEVICES.map((d, i) => {
      const off = d.retail - prices[i];
      return `<div class="card">
        <div class="brand">${d.brand}</div>
        <div class="device">${d.name}</div>
        <div class="retail">Retail ${money(d.retail)}</div>
        <div class="price">${money(prices[i])}</div>
        ${off > 0.005 ? `<span class="save">Save ${money(off)}</span>` : `<span class="save none">Retail price</span>`}
      </div>`; }).join("")}
    </div></div>`;
}
$("reset").onclick = () => { state.color = null; state.plan = null; render(); };
buildColors(); buildPlans(); render();

/* Auto-resize support for LMS iframes */
function postHeight(){ parent.postMessage({ type:"boost-offer-tool-height", height: document.documentElement.scrollHeight }, "*"); }
new ResizeObserver(postHeight).observe(document.body);
</script>


</body></html>